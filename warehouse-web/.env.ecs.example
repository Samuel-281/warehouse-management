# Aliyun ECS production variables.
# Copy this file to .env on the server and replace every placeholder.
# Never commit the real .env file.

# PostgreSQL is expected to run on the same ECS instance.
DATABASE_URL="postgresql://warehouse_app:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/warehouse_management?schema=public"

# Keep this true only when the super administrator needs to clear testing data.
NODE_ENV="production"
ALLOW_DEMO_DATABASE_RESET="true"
ALLOW_DEMO_PASSWORD_LOGIN="false"

# Keep false while visiting the ECS by plain http://IP.
# Change to true after binding an HTTPS domain.
SESSION_COOKIE_SECURE="false"
PUBLIC_APP_URL="http://REPLACE_WITH_ECS_PUBLIC_IP"

# Recommended for Next.js production.
NEXT_TELEMETRY_DISABLED="1"
