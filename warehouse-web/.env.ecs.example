# Aliyun ECS production variables.
# Copy this file to .env on the server and replace every placeholder.
# Never commit the real .env file.

# PostgreSQL is expected to run on the same ECS instance.
DATABASE_URL="postgresql://warehouse_app:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/warehouse_management?schema=public"

# Production mode keeps dangerous maintenance features closed by default.
NODE_ENV="production"
ALLOW_DEMO_DATABASE_RESET="false"
ALLOW_DEMO_PASSWORD_LOGIN="false"

# Recommended for Next.js production.
NEXT_TELEMETRY_DISABLED="1"
