# Netlify + Neon PostgreSQL trial deployment variables.
# Copy variable names into Netlify Site Settings -> Environment variables.
# Do not commit real production secrets.

# Required. Use the pooled Neon PostgreSQL connection string for serverless workloads.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&schema=public"

# Optional. Keep demo database reset disabled in trial/production by default.
# Set to "true" only for a disposable test database.
ALLOW_DEMO_DATABASE_RESET="false"

# Optional. Keep default demo password login disabled in production by default.
# Set to "true" only for a temporary private preview.
ALLOW_DEMO_PASSWORD_LOGIN="false"
