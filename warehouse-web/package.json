{
  "name": "warehouse-web",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node scripts/next-with-wasm.mjs dev --webpack",
    "build": "node scripts/next-with-wasm.mjs build --webpack",
    "start": "node scripts/next-with-wasm.mjs start",
    "lint": "eslint .",
    "test": "npm run test:integration",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db execute --file prisma/seed.sql",
    "db:reset-demo": "node scripts/reset-demo-db.mjs",
    "db:seed-stress": "node scripts/seed-stress-inventory.mjs",
    "db:benchmark": "tsx scripts/benchmark-large-data.ts",
    "db:cleanup-runtime": "node scripts/cleanup-runtime-data.mjs",
    "terminal-receipts:sync-weekly": "tsx scripts/sync-terminal-receipts.ts",
    "backup:oss": "node scripts/backup-postgres-to-oss.mjs",
    "backup:local": "node scripts/backup-postgres-to-oss.mjs --local-only",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.2.6",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.15",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "uuid": "^11.1.1"
  }
}
