{
  "name": "warehouse-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-with-wasm.mjs dev --webpack",
    "build": "node scripts/next-with-wasm.mjs build --webpack",
    "start": "node scripts/next-with-wasm.mjs start",
    "lint": "eslint .",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db execute --file prisma/seed.sql",
    "db:reset-demo": "prisma db execute --file prisma/reset-demo.sql && npm run db:seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.2.6",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.15",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
