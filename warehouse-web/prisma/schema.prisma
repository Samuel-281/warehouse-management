model SalesReturnOrderItem {
  id                String @id @default(uuid()) @db.Uuid
  orderId           String @db.Uuid
  inventoryItemId   String @db.Uuid
  barcode           String
  goodsId           String @db.Uuid
  fromSalespersonId String @db.Uuid
  beforeOwnerType OwnerType? @default(SALESPERSON)
  beforeWarehouseId String? @db.Uuid
  beforeLocationId String? @db.Uuid
  beforeSalespersonId String? @db.Uuid
  beforeTerminalStoreName String?
  beforeSignedAt DateTime?

  order           SalesReturnOrder @relation(fields: [orderId], references: [id])
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  goods           Goods            @relation(fields: [goodsId], references: [id])
