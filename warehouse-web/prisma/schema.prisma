generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GoodsCategory {
  HEALTH_WINE
  BAIJIU
}

enum RecordStatus {
  ENABLED
  DISABLED
}

enum OrderStatus {
  ACTIVE
  VOIDED
}

enum TrackingOrderStatus {
  ACTIVE
  MERGED
  VOIDED
}

enum TrackingReviewStatus {
  PENDING
  REVIEWED
  EXEMPT
}

enum TrackingGroupStatus {
  ACTIVE
  VOIDED
}

enum ProductCategorySource {
  MANUAL
  QINCE
}

enum TrackingReviewTargetType {
  ORDER
  GROUP
}

enum TrackingCorrectionTargetType {
  ORDER
  GROUP
}

enum OwnerType {
  WAREHOUSE
  SALESPERSON
  TERMINAL_STORE
}

enum ItemStatus {
  IN_STOCK
  WITH_SALESPERSON
  SIGNED
  RECEIPT_EXCEPTION
  WRITTEN_OFF
  VOIDED
}

enum InboundSource {
  FACTORY
  TERMINAL_RETURN
  OUTBOUND_SCAN
}

enum OutboundType {
  TRANSFER
  SALES
}

enum MovementType {
  FACTORY_INBOUND
  TERMINAL_RETURN_INBOUND
  TRANSFER
  SALES_OUTBOUND
  SALES_RETURN
  ORDER_REVERSAL
  BARCODE_CORRECTION
  WRITE_OFF
  MANUAL_ADJUSTMENT
}

enum ReceiptMatchStatus {
  MATCHED
  UNMATCHED
  CONFLICT
}

enum TerminalReceiptSyncTrigger {
  MANUAL
  SCHEDULED
}

enum TerminalReceiptSyncStatus {
  RUNNING
  SUCCESS
  FAILURE
}

enum TrackingOrderType {
  SALES_OUTBOUND
  TRANSFER
  RETURN
}

enum TrackingReceiptStatus {
  PENDING
  SIGNED
  EXCEPTION
}

enum TrackingItemStatus {
  ACTIVE
  WRITTEN_OFF
  VOIDED
}

enum TrackingMovementType {
  LEGACY_INBOUND
  SALES_OUTBOUND
  TRANSFER
  RETURN
  QINCE_RECEIPT
  ORDER_REVERSAL
  BARCODE_CORRECTION
  ORDER_CORRECTION
  TRACKING_VOID
  WRITE_OFF
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  username     String          @unique
  displayName  String
  passwordHash String
  status       RecordStatus    @default(ENABLED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  roles        UserRole[]
  sessions     UserSession[]
  operationLogs OperationLog[]
  businessRequests BusinessRequest[]
  trackingOrders TrackingOrder[]
  trackingOrderGroups TrackingOrderGroup[]
  trackingMovements TrackingMovement[]
  trackingOrderReviews TrackingOrderReview[] @relation("TrackingReviewOperator")
  trackingOrderCorrections TrackingOrderCorrection[] @relation("TrackingCorrectionOperator")

  inboundOrders      InboundOrder[]
  outboundOrders     OutboundOrder[]
  salesReturnOrders  SalesReturnOrder[]
  operatedMovements  StockMovement[]

  @@map("users")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  description String?
  status      RecordStatus @default(ENABLED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model OperationLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  username   String
  action     String
  targetType String
  targetId   String?
  result     String
  detail     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
  @@map("operation_logs")
}

model BusinessRequest {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  operationType   String
  clientRequestId String
  requestHash     String
  responseJson    Json?
  orderId         String?  @db.Uuid
  completedAt     DateTime?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, operationType, clientRequestId])
  @@index([expiresAt])
  @@map("business_requests")
}

model Goods {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique
  name      String
  category  GoodsCategory
  unit      String
  spec      String
  status    RecordStatus  @default(ENABLED)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  inventoryItems        InventoryItem[]
  warehouseStocks       WarehouseStock[]
  warehouseStockMovements WarehouseStockMovement[]
  stockMovements        StockMovement[]
  inboundOrderItems     InboundOrderItem[]
  outboundOrderItems    OutboundOrderItem[]
  salesReturnOrderItems SalesReturnOrderItem[]

  @@index([sortOrder])
  @@map("goods")
}

model Warehouse {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique
  name      String
  manager   String
  status    RecordStatus  @default(ENABLED)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  locations           StorageLocation[]
  inventoryItems      InventoryItem[]
  warehouseStocks     WarehouseStock[]
  warehouseStockMovements WarehouseStockMovement[]
  inboundOrders       InboundOrder[]
  sourceOutboundOrders OutboundOrder[]   @relation("SourceWarehouse")
  targetOutboundOrders OutboundOrder[]   @relation("TargetWarehouse")
  salesReturnOrders   SalesReturnOrder[]
  trackedBarcodes     TrackedBarcode[]
  sourceTrackingOrders TrackingOrder[] @relation("TrackingSourceWarehouse")
  targetTrackingOrders TrackingOrder[] @relation("TrackingTargetWarehouse")
  sourceTrackingOrderGroups TrackingOrderGroup[] @relation("TrackingGroupSourceWarehouse")
  targetTrackingOrderGroups TrackingOrderGroup[] @relation("TrackingGroupTargetWarehouse")

  @@index([sortOrder])
  @@map("warehouses")
}

model StorageLocation {
  id          String       @id @default(uuid()) @db.Uuid
  warehouseId String       @db.Uuid
  zone        String
  code        String
  name        String
  status      RecordStatus @default(ENABLED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  warehouse          Warehouse          @relation(fields: [warehouseId], references: [id])
  inventoryItems     InventoryItem[]
  inboundOrders      InboundOrder[]
  targetOutboundOrders OutboundOrder[]
  salesReturnOrders  SalesReturnOrder[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("storage_locations")
}

model Salesperson {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  phone     String
  region    String
  status    RecordStatus @default(ENABLED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  inventoryItems        InventoryItem[]
  outboundOrders        OutboundOrder[]
  salesReturnOrderItems SalesReturnOrderItem[]
  trackedBarcodes        TrackedBarcode[]
  trackingOrders         TrackingOrder[]
  trackingOrderGroups    TrackingOrderGroup[]

  @@map("salespeople")
}

model TerminalStore {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  contact   String
  phone     String
  address   String
  status    RecordStatus @default(ENABLED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  inboundOrders InboundOrder[]

  @@map("terminal_stores")
}

model InventoryItem {
  id             String        @id @default(uuid()) @db.Uuid
  barcode        String        @unique
  goodsId        String        @db.Uuid
  ownerType      OwnerType
  warehouseId    String?       @db.Uuid
  locationId     String?       @db.Uuid
  salespersonId  String?       @db.Uuid
  terminalStoreName String?
  signedAt       DateTime?
  status         ItemStatus
  productionDate DateTime?     @db.Date
  shelfLifeDate  DateTime?     @db.Date
  inboundSource  InboundSource
  lastMovedAt    DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  goods                 Goods                  @relation(fields: [goodsId], references: [id])
  warehouse             Warehouse?             @relation(fields: [warehouseId], references: [id])
  location              StorageLocation?       @relation(fields: [locationId], references: [id])
  salesperson           Salesperson?           @relation(fields: [salespersonId], references: [id])
  stockMovements        StockMovement[]
  inboundOrderItems     InboundOrderItem[]
  outboundOrderItems    OutboundOrderItem[]
  salesReturnOrderItems SalesReturnOrderItem[]
  barcodeCorrections    BarcodeCorrection[]
  terminalReceiptRecords TerminalReceiptRecord[]

  @@index([goodsId])
  @@index([warehouseId])
  @@index([salespersonId])
  @@index([lastMovedAt])
  @@index([ownerType, warehouseId, lastMovedAt])
  @@index([ownerType, salespersonId, lastMovedAt])
  @@index([ownerType, terminalStoreName, lastMovedAt])
  @@index([status, lastMovedAt])
  @@index([goodsId, lastMovedAt])
  @@map("inventory_items")
}

model TerminalReceiptImport {
  id             String   @id @default(uuid()) @db.Uuid
  fileName       String
  fileHash       String   @unique
  totalRows      Int
  importedRows   Int
  matchedRows    Int
  unmatchedRows  Int
  conflictRows   Int      @default(0)
  duplicateRows  Int
  invalidRows    Int
  operatorName   String
  createdAt      DateTime @default(now())

  records  TerminalReceiptRecord[]
  syncRuns TerminalReceiptSyncRun[]

  @@index([createdAt])
  @@map("terminal_receipt_imports")
}

model TerminalReceiptSyncRun {
  id                 String                    @id @default(uuid()) @db.Uuid
  trigger            TerminalReceiptSyncTrigger
  status             TerminalReceiptSyncStatus @default(RUNNING)
  logicalStartAt     DateTime
  logicalEndAt       DateTime
  exportStartDate    DateTime                  @db.Date
  exportEndDate      DateTime                  @db.Date
  externalTaskKey    String?
  externalFileName   String?
  importId           String?                   @db.Uuid
  totalRows          Int                       @default(0)
  importedRows       Int                       @default(0)
  matchedRows        Int                       @default(0)
  unmatchedRows      Int                       @default(0)
  conflictRows       Int                       @default(0)
  duplicateRows      Int                       @default(0)
  invalidRows        Int                       @default(0)
  operatorName       String
  errorMessage       String?
  startedAt          DateTime                  @default(now())
  finishedAt         DateTime?
  createdAt          DateTime                  @default(now())

  importBatch TerminalReceiptImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([status, startedAt(sort: Desc)])
  @@index([logicalEndAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("terminal_receipt_sync_runs")
}

model TerminalReceiptRecord {
  id                        String             @id @default(uuid()) @db.Uuid
  importId                  String             @db.Uuid
  inventoryItemId           String?            @db.Uuid
  trackedBarcodeId          String?            @db.Uuid
  barcode                   String
  scannedAt                 DateTime
  scannerName               String
  externalGoodsName         String
  goodsUnit                 String
  receivingOrganizationName String
  fingerprint               String             @unique
  matchStatus               ReceiptMatchStatus
  productCategoryId         String?            @db.Uuid
  createdAt                 DateTime           @default(now())

  import        TerminalReceiptImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?        @relation(fields: [inventoryItemId], references: [id])
  trackedBarcode TrackedBarcode?       @relation(fields: [trackedBarcodeId], references: [id])
  productCategory ProductCategory?      @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)
  trackingMovement TrackingMovement?

  @@index([barcode, scannedAt(sort: Desc)])
  @@index([inventoryItemId, scannedAt(sort: Desc)])
  @@index([trackedBarcodeId, scannedAt(sort: Desc)])
  @@index([receivingOrganizationName])
  @@index([importId])
  @@index([productCategoryId])
  @@map("terminal_receipt_records")
}

model TrackedBarcode {
  id                    String                @id @default(uuid()) @db.Uuid
  barcode               String                @unique
  externalGoodsName     String?
  goodsUnit             String?
  productCategoryId     String?               @db.Uuid
  currentOwnerType      OwnerType
  warehouseId           String?               @db.Uuid
  salespersonId         String?               @db.Uuid
  terminalStoreName     String?
  receiptStatus         TrackingReceiptStatus @default(PENDING)
  status                TrackingItemStatus    @default(ACTIVE)
  signedAt              DateTime?
  lastMovedAt           DateTime
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  warehouse             Warehouse?             @relation(fields: [warehouseId], references: [id])
  salesperson           Salesperson?           @relation(fields: [salespersonId], references: [id])
  movements             TrackingMovement[]
  orderItems            TrackingOrderBarcode[]
  terminalReceiptRecords TerminalReceiptRecord[]
  productCategory       ProductCategory?       @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)

  @@index([currentOwnerType, warehouseId, lastMovedAt(sort: Desc)])
  @@index([currentOwnerType, salespersonId, lastMovedAt(sort: Desc)])
  @@index([receiptStatus, lastMovedAt(sort: Desc)])
  @@index([externalGoodsName])
  @@index([terminalStoreName])
  @@index([productCategoryId])
  @@map("tracked_barcodes")
}

model TrackingBarcodeReservation {
  id        String   @id @default(uuid()) @db.Uuid
  barcode   String   @unique
  sessionId String
  userId    String?  @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([expiresAt])
  @@map("tracking_barcode_reservations")
}

model TrackingOrder {
  id                String            @id @default(uuid()) @db.Uuid
  orderNo           String            @unique
  type              TrackingOrderType
  sourceWarehouseId String?           @db.Uuid
  targetWarehouseId String?           @db.Uuid
  salespersonId     String?           @db.Uuid
  operatorId        String?           @db.Uuid
  operatorName      String
  status            TrackingOrderStatus @default(ACTIVE)
  reviewStatus      TrackingReviewStatus @default(PENDING)
  correctedAfterReview Boolean        @default(false)
  voidedAt          DateTime?
  voidedByUserId    String?           @db.Uuid
  voidedByName      String?
  voidReason        String?
  createdAt         DateTime          @default(now())

  sourceWarehouse   Warehouse?        @relation("TrackingSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouse   Warehouse?        @relation("TrackingTargetWarehouse", fields: [targetWarehouseId], references: [id])
  salesperson       Salesperson?      @relation(fields: [salespersonId], references: [id])
  operator          User?             @relation(fields: [operatorId], references: [id])
  items             TrackingOrderBarcode[]
  movements         TrackingMovement[]
  groupMembership   TrackingOrderGroupMember?
  reviews           TrackingOrderReview[]
  corrections       TrackingOrderCorrection[]

  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([sourceWarehouseId, createdAt(sort: Desc)])
  @@index([targetWarehouseId, createdAt(sort: Desc)])
  @@index([salespersonId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([reviewStatus, createdAt(sort: Desc)])
  @@map("tracking_orders")
}

model TrackingOrderGroup {
  id                String   @id @default(uuid()) @db.Uuid
  groupNo           String   @unique
  type              TrackingOrderType
  sourceWarehouseId String   @db.Uuid
  targetWarehouseId String?  @db.Uuid
  salespersonId     String?  @db.Uuid
  operatorId        String?  @db.Uuid
  operatorName      String
  status            TrackingGroupStatus @default(ACTIVE)
  reviewStatus      TrackingReviewStatus @default(PENDING)
  correctedAfterReview Boolean @default(false)
  correctedAt       DateTime?
  voidedAt          DateTime?
  voidedByUserId    String? @db.Uuid
  voidedByName      String?
  voidReason        String?
  createdAt         DateTime @default(now())

  sourceWarehouse   Warehouse @relation("TrackingGroupSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouse   Warehouse? @relation("TrackingGroupTargetWarehouse", fields: [targetWarehouseId], references: [id])
  salesperson       Salesperson? @relation(fields: [salespersonId], references: [id])
  operator          User? @relation(fields: [operatorId], references: [id])
  members           TrackingOrderGroupMember[]
  reviews           TrackingOrderReview[]
  corrections       TrackingOrderCorrection[]
  movements         TrackingMovement[]

  @@index([createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([sourceWarehouseId, salespersonId, createdAt(sort: Desc)])
  @@index([sourceWarehouseId, targetWarehouseId, createdAt(sort: Desc)])
  @@index([status, reviewStatus, createdAt(sort: Desc)])
  @@map("tracking_order_groups")
}

model TrackingOrderGroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  orderId   String   @unique @db.Uuid
  createdAt DateTime @default(now())

  group TrackingOrderGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  order TrackingOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([groupId, orderId])
  @@index([groupId])
  @@map("tracking_order_group_members")
}

model TrackingOrderBarcode {
  id                        String       @id @default(uuid()) @db.Uuid
  orderId                   String       @db.Uuid
  trackedBarcodeId          String       @db.Uuid
  barcode                   String
  beforeOwnerType           OwnerType?
  beforeWarehouseId         String?      @db.Uuid
  beforeSalespersonId       String?      @db.Uuid
  beforeTerminalStoreName   String?
  beforeReceiptStatus       TrackingReceiptStatus?
  beforeSignedAt            DateTime?
  createdTrackingItem       Boolean      @default(false)

  order                     TrackingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackedBarcode            TrackedBarcode @relation(fields: [trackedBarcodeId], references: [id])

  @@unique([orderId, barcode])
  @@index([barcode])
  @@index([trackedBarcodeId])
  @@map("tracking_order_barcodes")
}

model ProductCategory {
  id             String                @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String                @unique
  status         RecordStatus          @default(ENABLED)
  source         ProductCategorySource
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  trackedBarcodes TrackedBarcode[]
  terminalReceiptRecords TerminalReceiptRecord[]
  reviewItems     TrackingOrderReviewItem[]

  @@index([status, name])
  @@map("product_categories")
}

model TrackingOrderReview {
  id                  String                   @id @default(uuid()) @db.Uuid
  targetType          TrackingReviewTargetType
  orderId             String?                  @db.Uuid
  groupId             String?                  @db.Uuid
  version             Int
  actualTotalQuantity Int
  activeBarcodeCount  Int
  operatorId          String?                  @db.Uuid
  operatorName        String
  createdAt           DateTime                 @default(now())

  order               TrackingOrder?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  group               TrackingOrderGroup?      @relation(fields: [groupId], references: [id], onDelete: Restrict)
  operator            User?                    @relation("TrackingReviewOperator", fields: [operatorId], references: [id])
  items               TrackingOrderReviewItem[]

  @@unique([orderId, version])
  @@unique([groupId, version])
  @@index([targetType, createdAt(sort: Desc)])
  @@index([operatorId])
  @@map("tracking_order_reviews")
}

model TrackingOrderReviewItem {
  id                String              @id @default(uuid()) @db.Uuid
  reviewId          String              @db.Uuid
  productCategoryId String              @db.Uuid
  categoryName      String
  quantity          Int

  review            TrackingOrderReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  productCategory   ProductCategory     @relation(fields: [productCategoryId], references: [id], onDelete: Restrict)

  @@unique([reviewId, productCategoryId])
  @@index([productCategoryId])
  @@map("tracking_order_review_items")
}

model TrackingOrderCorrection {
  id                        String                       @id @default(uuid()) @db.Uuid
  targetType                TrackingCorrectionTargetType
  orderId                   String?                      @db.Uuid
  groupId                   String?                      @db.Uuid
  beforeType                TrackingOrderType
  afterType                 TrackingOrderType
  beforeSourceWarehouseId   String                       @db.Uuid
  afterSourceWarehouseId    String                       @db.Uuid
  beforeTargetWarehouseId   String?                      @db.Uuid
  afterTargetWarehouseId    String?                      @db.Uuid
  beforeSalespersonId       String?                      @db.Uuid
  afterSalespersonId        String?                      @db.Uuid
  note                      String?
  operatorId                String?                      @db.Uuid
  operatorName              String
  createdAt                 DateTime                     @default(now())

  order                     TrackingOrder?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  group                     TrackingOrderGroup?          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  operator                  User?                        @relation("TrackingCorrectionOperator", fields: [operatorId], references: [id])

  @@index([orderId, createdAt(sort: Desc)])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([operatorId])
  @@map("tracking_order_corrections")
}

model TrackingMovement {
  id                    String               @id @default(uuid()) @db.Uuid
  trackedBarcodeId      String               @db.Uuid
  barcode               String
  type                  TrackingMovementType
  fromOwnerType         OwnerType?
  toOwnerType           OwnerType
  fromLabel             String
  toLabel               String
  operatorId            String?              @db.Uuid
  operatorName          String
  occurredAt            DateTime
  note                  String
  orderId               String?              @db.Uuid
  orderNo               String?
  groupId               String?              @db.Uuid
  groupNo               String?
  receiptRecordId       String?              @unique @db.Uuid

  trackedBarcode        TrackedBarcode       @relation(fields: [trackedBarcodeId], references: [id])
  operator              User?                @relation(fields: [operatorId], references: [id])
  order                 TrackingOrder?       @relation(fields: [orderId], references: [id])
  group                 TrackingOrderGroup?  @relation(fields: [groupId], references: [id])
  receiptRecord         TerminalReceiptRecord? @relation(fields: [receiptRecordId], references: [id], onDelete: SetNull)

  @@index([trackedBarcodeId, occurredAt(sort: Desc)])
  @@index([barcode, occurredAt(sort: Desc)])
  @@index([orderId])
  @@index([groupId])
  @@index([type, occurredAt(sort: Desc)])
  @@map("tracking_movements")
}

model WarehouseStock {
  id            String   @id @default(uuid()) @db.Uuid
  warehouseId   String   @db.Uuid
  goodsId       String   @db.Uuid
  quantity      Int      @default(0)
  lastChangedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  goods     Goods     @relation(fields: [goodsId], references: [id])

  @@unique([warehouseId, goodsId])
  @@index([goodsId])
  @@index([lastChangedAt])
  @@map("warehouse_stocks")
}

model WarehouseStockMovement {
  id           String       @id @default(uuid()) @db.Uuid
  warehouseId  String       @db.Uuid
  goodsId      String       @db.Uuid
  type         MovementType
  quantityChange Int
  balanceAfter   Int
  orderKind    String?
  orderId      String?      @db.Uuid
  orderNo      String?
  reversalOfMovementId String? @db.Uuid
  barcode      String?
  counterparty String?
  operatorName String
  occurredAt   DateTime
  note         String

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  goods     Goods     @relation(fields: [goodsId], references: [id])

  @@index([warehouseId, goodsId])
  @@index([goodsId])
  @@index([occurredAt])
  @@index([barcode])
  @@index([orderKind, orderId])
  @@map("warehouse_stock_movements")
}

model StockMovement {
  id           String       @id @default(uuid()) @db.Uuid
  itemId       String       @db.Uuid
  barcode      String
  goodsId      String       @db.Uuid
  type         MovementType
  fromLabel    String
  toLabel      String
  operatorId   String?      @db.Uuid
  operatorName String
  occurredAt   DateTime
  note         String
  orderKind    String?
  orderId      String?      @db.Uuid
  orderNo      String?
  reversalOfMovementId String? @db.Uuid

  item     InventoryItem @relation(fields: [itemId], references: [id])
  goods    Goods         @relation(fields: [goodsId], references: [id])
  operator User?         @relation(fields: [operatorId], references: [id])

  @@index([goodsId])
  @@index([occurredAt])
  @@index([barcode, occurredAt(sort: Desc)])
  @@index([itemId, occurredAt(sort: Desc)])
  @@index([orderKind, orderId])
  @@map("stock_movements")
}

model InboundOrder {
  id              String        @id @default(uuid()) @db.Uuid
  orderNo         String        @unique
  source          InboundSource
  warehouseId     String        @db.Uuid
  locationId      String        @db.Uuid
  terminalStoreId String?       @db.Uuid
  operatorId      String?       @db.Uuid
  operatorName    String
  createdAt       DateTime      @default(now())
  status          OrderStatus   @default(ACTIVE)
  reversalSupported Boolean     @default(true)
  voidedAt        DateTime?
  voidedByUserId  String?       @db.Uuid
  voidedByName    String?
  voidReason      String?

  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  location      StorageLocation  @relation(fields: [locationId], references: [id])
  terminalStore TerminalStore?   @relation(fields: [terminalStoreId], references: [id])
  operator      User?            @relation(fields: [operatorId], references: [id])
  items         InboundOrderItem[]

  @@index([source])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("inbound_orders")
}

model InboundOrderItem {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String    @db.Uuid
  inventoryItemId String?   @db.Uuid
  barcode         String?
  goodsId         String    @db.Uuid
  quantity        Int       @default(1)
  productionDate  DateTime? @db.Date
  shelfLifeDate   DateTime? @db.Date
  beforeOwnerType OwnerType?
  beforeWarehouseId String? @db.Uuid
  beforeLocationId String? @db.Uuid
  beforeSalespersonId String? @db.Uuid
  beforeTerminalStoreName String?
  beforeSignedAt DateTime?
  createdTrackingItem Boolean @default(false)

  order         InboundOrder @relation(fields: [orderId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  goods         Goods        @relation(fields: [goodsId], references: [id])

  @@index([barcode])
  @@index([goodsId])
  @@index([orderId])
  @@index([inventoryItemId])
  @@map("inbound_order_items")
}

model OutboundOrder {
  id                String       @id @default(uuid()) @db.Uuid
  orderNo           String       @unique
  type              OutboundType
  sourceWarehouseId String       @db.Uuid
  targetWarehouseId String?      @db.Uuid
  targetLocationId  String?      @db.Uuid
  salespersonId     String?      @db.Uuid
  operatorId        String?      @db.Uuid
  operatorName      String
  createdAt         DateTime     @default(now())
  status            OrderStatus  @default(ACTIVE)
  reversalSupported Boolean      @default(true)
  voidedAt          DateTime?
  voidedByUserId    String?      @db.Uuid
  voidedByName      String?
  voidReason        String?

  sourceWarehouse Warehouse        @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse?       @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id])
  targetLocation  StorageLocation? @relation(fields: [targetLocationId], references: [id])
  salesperson     Salesperson?     @relation(fields: [salespersonId], references: [id])
  operator        User?            @relation(fields: [operatorId], references: [id])
  items           OutboundOrderItem[]

  @@index([type])
  @@index([sourceWarehouseId])
  @@index([targetWarehouseId])
  @@index([salespersonId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("outbound_orders")
}

model OutboundOrderItem {
  id              String @id @default(uuid()) @db.Uuid
  orderId         String @db.Uuid
  inventoryItemId String @db.Uuid
  barcode         String
  goodsId         String @db.Uuid
  beforeOwnerType OwnerType?
  beforeWarehouseId String? @db.Uuid
  beforeLocationId String? @db.Uuid
  beforeSalespersonId String? @db.Uuid
  beforeTerminalStoreName String?
  beforeSignedAt DateTime?
  createdTrackingItem Boolean @default(false)

  order         OutboundOrder @relation(fields: [orderId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  goods         Goods         @relation(fields: [goodsId], references: [id])

  @@index([barcode])
  @@index([goodsId])
  @@index([orderId])
  @@index([inventoryItemId])
  @@map("outbound_order_items")
}

model SalesReturnOrder {
