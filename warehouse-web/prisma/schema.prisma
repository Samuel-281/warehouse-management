  orderNo           String   @unique
  returnWarehouseId String   @db.Uuid
  returnLocationId  String   @db.Uuid
  operatorId        String?  @db.Uuid
  operatorName      String
  createdAt         DateTime @default(now())
  status            OrderStatus @default(ACTIVE)
  reversalSupported Boolean @default(true)
  voidedAt          DateTime?
  voidedByUserId    String? @db.Uuid
  voidedByName      String?
  voidReason        String?

  returnWarehouse Warehouse        @relation(fields: [returnWarehouseId], references: [id])
  returnLocation  StorageLocation @relation(fields: [returnLocationId], references: [id])
  operator        User?           @relation(fields: [operatorId], references: [id])
  items           SalesReturnOrderItem[]

