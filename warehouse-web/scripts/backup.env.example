# Copy to scripts/backup.env on the ECS server. Do not commit the real file.

# Private OSS bucket name without oss://. Keep the bucket private.
OSS_BUCKET="replace-with-private-bucket"
OSS_PREFIX="warehouse-management"
OSS_REGION="cn-hongkong"

# ossutil 2.x obtains temporary credentials from the ECS RAM role.
# A config file is optional when --mode Ali-EcsRamRole and OSS_REGION are sufficient.
# OSSUTIL_CONFIG_FILE="/root/.ossutilconfig"

BACKUP_DIRECTORY="/www/backup/warehouse-management"
BACKUP_STATUS_FILE="/www/wwwroot/warehouse-management/warehouse-web/runtime/backup-status.json"
BACKUP_LOCAL_RETENTION_DAYS="7"

# Local Docker-only testing option. Do not set this on a normal ECS PostgreSQL installation.
# POSTGRES_DOCKER_CONTAINER="warehouse-management-postgres"
